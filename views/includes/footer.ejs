<footer class="site-footer mt-4 mb-0">
  <div class="container py-4">

    <div class="row gy-4">

      <!-- Brand -->
      <div class="col-md-4">
        <h5 class="fw-bold d-flex align-items-center gap-2">
          <i class="fa-solid fa-book-open-reader text-info"></i>
          Work X
        </h5>

        <p class="   small mb-0">
          A simple platform to organize topics, track progress,
          and build a consistent learning habit.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="col-md-4">
        <h6 class="fw-semibold mb-3">Quick Links</h6>

        <ul class="list-unstyled">
          <li class="mb-2">
            <a href="/" class="text-decoration-none   ">
              Home
            </a>
          </li>

          <li class="mb-2">
            <a href="/logs" class="text-decoration-none   ">
              Logs
            </a>
          </li>

          <li class="mb-2">
            <a href="/log/new" class="text-decoration-none   ">
              Add Log
            </a>
          </li>
        </ul>
      </div>

      <!-- User Actions -->
      <div class="col-md-4">
        <h6 class="fw-semibold mb-3">Account</h6>

        <% if(currentUser) { %>

          <p class="   small">
            Signed in as
            <strong><%= currentUser.username %></strong>
          </p>

          <a
            href="/logout"
            class="btn btn-outline-danger btn-sm"
          >
            Logout
          </a>

        <% } else { %>

          <a
            href="/login"
            class="btn btn-outline-info btn-sm me-2"
          >
            Login
          </a>

          <a
            href="/signup"
            class="btn btn-info btn-sm text-white"
          >
            Sign Up
          </a>

        <% } %>
      </div>

    </div>

    <hr>

    <!-- Bottom Row -->
    
  

  <div class="text-center">
  <p class="small    mb-0">
    © 2026 Work X. All rights reserved.
  </p>
</div>
      
  

  </div>
</footer>