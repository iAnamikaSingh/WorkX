<% layout("boilerplate.ejs") %>

<div class="w-100 d-flex justify-content-center">
  
    <div class="w-100  rounded-4 shadow  p-4 p-md-5 " style="max-width: 390px;">
        <div class="text-center mb-4">
          <h2 class="fw-bold fs-2">Welcome Back</h2>
          <p class="fw-semibold fs-5 ">Login to your account</p>
        </div>

        <form method="POST" action="/login" class="needs-validation" novalidate>
          <div class="mb-4 ">
            <label for="username" class="form-label small fw-semibold">USERNAME</label>
            <input
              class="form-control border-secondary"
              name="username"
              type="text"
              id="username"
              placeholder=" "
              autocomplete="username"
              required
            />
            <div class="invalid-feedback">
              Username is required.
            </div>
            
          </div>

          <div class="mb-4">
            <div>
    
              <label for="password" class="form-label small fw-semibold">PASSWORD</label>
              <div class="input-group has-validation">
                <input
                class="form-control border-secondary"
                name="password"
                type="password"
                id="password"
                placeholder=" "
                autocomplete="current-password"
                required
              />
              
              <button
                class="btn toggle-password-btn btn btn-outline-secondary" 
                type="button"
                id="togglePassword"
                aria-label="Show password"
              >
              <i class="fa-solid fa-eye "></i>
              </button>
              <div class="invalid-feedback">
                Password is required.
              </div>
              </div>
              
                
            </div>
          </div>

          <button type="submit" class="btn btn-info w-100 fw-semibold mb-3">
            <i class="fa-solid fa-right-to-bracket me-2"></i>
            Login
          </button>
        </form>

        <p class="text-center fw-semibold mb-0">
          New user?
          <a href="/signup" class="fw-semibold text-info text-decoration-none"
            >Create an account</a
          >
        </p>
      </div>
    </div>


<script src="/js/login.js"></script>

