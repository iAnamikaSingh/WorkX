<% layout("boilerplate.ejs") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
      <div class="auth-card glass-card p-4 p-md-5 fade-in-up">
        <div class="text-center mb-4">
          <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-4" style="width: 72px; height: 72px; background: rgba(56, 189, 248, 0.14);">
            <i class="fa-solid fa-right-to-bracket fa-2x text-info"></i>
          </div>
          <h2 class="fw-bold mt-3">Welcome Back</h2>
          <p class="text-muted mb-0">Log in to continue.</p>
        </div>

        <form method="POST" action="/login" class="needs-validation" novalidate>
          <div class="mb-4 floating-group">
            <input class="form-control" name="username" type="text" id="username" placeholder=" " required />
            <label for="username">Username</label>
          </div>

          <div class="mb-4 floating-group">
            <div class="input-group align-items-center">
              <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
              <input class="form-control" name="password" type="password" id="password" placeholder=" " required />
              <label for="password">Password</label>
              <button class="btn btn-light toggle-password-btn" type="button" id="togglePassword" aria-label="Show password">
                <i class="fa-solid fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-info w-100 fw-semibold mb-3">
            <i class="fa-solid fa-right-to-bracket me-2"></i>
            Login
          </button>
        </form>

        <p class="text-center text-muted mb-0 small">
          New user? <a href="/signup" class="text-info text-decoration-none">Create an account</a>
        </p>
      </div>
    </div>
  </div>
</div>
<script src="/js/login.js"></script>
