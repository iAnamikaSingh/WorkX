<% layout("boilerplate.ejs") %>

<div class="py-4 py-md-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Admin Panel</h1>
      <p class="text-muted mb-0">View registered users and their signup details.</p>
    </div>
  </div>

  <div class="card shadow-sm rounded-4">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Username</th>
              <th scope="col">Email</th>
              <th scope="col">Signed Up</th>
              <th scope="col">Role</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length) { %>
              <% users.forEach((user) => { %>
                <tr>
                  <td class="fw-semibold text-dark"><%= user.username %></td>
                  <td><%= user.email %></td>
                  <td><%= user.createdAt ? user.createdAt.toLocaleString("en-IN") : "N/A" %></td>
                  <td>
                    <% if (user.isAdmin) { %>
                      <span class="badge bg-info text-white">Admin</span>
                    <% } else { %>
                      <span class="badge bg-secondary">User</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-4">No users found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
