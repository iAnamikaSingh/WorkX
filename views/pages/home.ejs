
<% layout("boilerplate.ejs") %>

<div class="d-flex align-items-center justify-content-center py-5">
  <div class="text-center" style="max-width: 760px;">
    
    <h1 class="display-5 fw-bold mb-4">Work X </h1>
    <p class="text-info fw-semibold mb-2 mt-4">Organize learning with clarity</p>
    <p class="lead text-muted mb-4">
      Sign up, verify your email, then add learning logs with topics and subtopics. Track what you studied and return to your notes anytime.
    </p>

    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mb-5">
      <a href="/signup" class="btn btn-info btn-lg px-4 rounded-pill text-white">
        <i class="fa-solid fa-user-plus me-2"></i>
        Create account
      </a>
      <a href="/login" class="btn btn-outline-info btn-lg px-4 rounded-pill">
        <i class="fa-solid fa-right-to-bracket me-2"></i>
        Login
      </a>
    </div>

    <div class="row g-4 text-start">
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100">
          <div class="mb-3 text-info">
            <i class="fa-solid fa-envelope-open-text fa-2x"></i>
          </div>
          <h5 class="fw-semibold">Verify your email</h5>
          <p class="small text-muted mb-0">
            Enter your email, receive a one-time password, and confirm your address before creating your Work X account.
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100">
          <div class="mb-3 text-info">
            <i class="fa-solid fa-user-check fa-2x"></i>
          </div>
          <h5 class="fw-semibold">Create your profile</h5>
          <p class="small text-muted mb-0">
            Choose a username and password, then log in to access your personal workspace and learning logs.
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100">
          <div class="mb-3 text-info">
            <i class="fa-solid fa-circle-plus fa-2x"></i>
          </div>
          <h5 class="fw-semibold">Add learning logs</h5>
          <p class="small text-muted mb-0">
            Record sessions with topics, subtopics, notes, and key takeaways. Each entry is saved for future review.
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100">
          <div class="mb-3 text-info">
            <i class="fa-solid fa-list-check fa-2x"></i>
          </div>
          <h5 class="fw-semibold">Review and refine</h5>
          <p class="small text-muted mb-0">
            Browse your logs on the dashboard, edit entries, and keep your learning progress visible and actionable.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<section class="py-5">
  <div class="row align-items-center gy-4">
    <div class="col-lg-6">
      <div class="p-4 bg-light rounded-4">
        <h2 class="fw-bold mb-3">Why Work X?</h2>
        <p class="text-muted mb-4">
          Work X turns scattered study notes into a simple habit. Use the platform to structure your learning, keep topics organized, and build consistency over time.
        </p>

        <ul class="list-unstyled small text-muted">
          <li class="mb-3">
            <span class="fw-semibold text-dark">Organize topics:</span> group what you learn into clear subject areas and subtopics.
          </li>
          <li class="mb-3">
            <span class="fw-semibold text-dark">Track sessions:</span> every log saves the date, notes, and progress so you can revisit your work.
          </li>
          <li class="mb-3">
            <span class="fw-semibold text-dark">Stay focused:</span> a clean workflow helps you move quickly from signup to action.
          </li>
        </ul>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="p-4 bg-white border rounded-4 shadow-sm">
        <h3 class="fw-semibold mb-3">Workflow at a glance</h3>
        <div class="d-flex align-items-start gap-3 mb-3">
          <span class="badge bg-info text-white rounded-circle p-3">1</span>
          <div>
            <h6 class="mb-1">Open the app</h6>
            <p class="small text-muted mb-0">Visit the homepage, then sign up with an email and username.</p>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3 mb-3">
          <span class="badge bg-info text-white rounded-circle p-3">2</span>
          <div>
            <h6 class="mb-1">Verify email</h6>
            <p class="small text-muted mb-0">Receive an OTP in your inbox and complete verification before continuing.</p>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3 mb-3">
          <span class="badge bg-info text-white rounded-circle p-3">3</span>
          <div>
            <h6 class="mb-1">Create your first log</h6>
            <p class="small text-muted mb-0">Add a new learning log with topics and optional subtopics to capture what you studied.</p>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <span class="badge bg-info text-white rounded-circle p-3">4</span>
          <div>
            <h6 class="mb-1">Review and repeat</h6>
            <p class="small text-muted mb-0">Use the logs page to revisit, edit, or delete entries as your learning evolves.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

