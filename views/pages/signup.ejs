  <div class="row justify-content-center ">
    <div class="col-md-6 col-lg-4 card bg-outline-info py-5 px-4 d-flex flex-column">
      <h2 class="text-center">Register</h2>
      <form method="post" action="/signup" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="email" class="form-label small">EMAIL</label>
          <input type="email" class="form-control" id="email" placeholder="john@gmail.com" name="email" required>
          <div class="invalid-feedback">
            Please enter a valid email address.
          </div>
        </div>

        <button class="mb-3 btn btn-outline-info w-100 send-otp" type="button">Send OTP</button>
        <div id="otp-msg" class="mb-4 text-center"></div>
        <div id="otp-section" style="display:none; ">
          <div class="mb-3">
            <label for="otp" class="form-label small">Enter OTP</label>
            <input type="text" class="form-control" id="otp" placeholder=" " name="otp" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" required>
            <div class="invalid-feedback">
              Please enter the OTP containing exactly 6 digits.
            </div>
          </div>
          <button class="mb-3 btn btn-outline-success w-100 verify-email" type="button">Verify Email</button>
          <div id="verification-msg" class="mb-4 text-center"></div>
        </div>
        
        <div class="mb-3">
          <label for="username" class="form-label small">USERNAME</label>
          <input type="text" class="form-control" id="username" placeholder="john@workx" name="username" minlengh="3" required>
          <div class="invalid-feedback">
            Username is required.
          </div>
        </div>
        <div class="mb-3">
          <label for="pass" class="form-label small">PASSWORD</label>
          <div class="input-group has-validation">
            <input type="password" class="form-control" id="pass" name="pass"  placeholder="Create password" minlength="8" 
              pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]).{8,}$" required>
            <button 
              class="btn btn-outline-secondary toggle-password-btn"
              type="button"
              id="togglePassword"
            >
            <i class="fa-solid fa-eye"></i>
          </button>
          <div class="invalid-feedback">
            Please create a password that is at least 8 characters long and contains at least one lowercase letter, one uppercase letter, and one digit.
           </div>
          </div> 
           
        </div>
        <button type="submit" class="btn btn-primary w-100">Sign up</button>
      </form>
   
  </div>
</div>


<script src="/js/signup.js"></script>
