<% layout("boilerplate.ejs") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
      <div class="glass-card p-4 p-md-5 fade-in-up">
        <div class="d-flex align-items-center gap-3 mb-4">
          <div class="rounded-4" style="width: 56px; height: 56px; background: rgba(56, 189, 248, 0.14); display: grid; place-items: center;">
            <i class="fa-solid fa-plus text-info"></i>
          </div>
          <div>
            <h1 class="h4 mb-1 fw-semibold">New Work Log</h1>
            <p class="text-muted mb-0 small">Capture your plan in a structured, easy-to-review format.</p>
          </div>
        </div>

        <% if (success) { %>
          <div class="alert alert-success d-flex justify-content-between align-items-start" role="alert">
            <span><%= success %></span>
            <button type="button" class="btn-close" aria-label="Close"></button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger d-flex justify-content-between align-items-start" role="alert">
            <span><%= error %></span>
            <button type="button" class="btn-close" aria-label="Close"></button>
          </div>
        <% } %>

        <form action="/logs" method="POST">
          <div class="mb-4 floating-group">
            <input type="date" name="date" id="date" class="form-control" placeholder=" " required />
            <label for="date">Date</label>
          </div>

          <hr class="my-4" />

          <div id="topicsContainer"></div>

          <div class="d-flex flex-wrap gap-3 mt-3">
            <button type="button" id="addTopicBtn" class="btn btn-outline-info">
              <i class="fa-solid fa-plus me-1"></i> Add Topic
            </button>
            <button type="submit" class="btn btn-outline-success">
              <i class="fa-solid fa-floppy-disk me-1"></i> Save Log
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/newDataForm.js"></script>
<script>
  document.getElementById("date").valueAsDate = new Date();
</script>
