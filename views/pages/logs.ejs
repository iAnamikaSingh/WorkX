<% layout("boilerplate.ejs") %>

<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h3 mb-1 fw-semibold text-white">Activity Log</h2>
        <p class="text-muted mb-0 small">Review your learning sessions and keep everything organized.</p>
      </div>
    </div>

    <% if (data && data.length) { %>
      <% for(each of data){ %>
        <div class="card log-card shadow-sm mb-4">
          <div class="card-body p-4 p-md-4">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
              <div>
                <h3 class="h5 mb-1 fw-semibold text-white">
                  <i class="fa-solid fa-calendar-days me-2 text-info"></i>
                  <%= each.date.toLocaleString("en-IN", {
                    weekday: "long",
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                  }) %>
                </h3>
              </div>
            </div>

            <% each.topics.forEach((topic, topicIndex) => { %>
              <div class="topic-block">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                  <h4 class="h6 fw-semibold text-white mb-0"><%= topic.topicName %></h4>
                  <form method="POST" action="/log/<%= each._id %>/topic/<%= topicIndex %>?_method=DELETE" class="d-inline">
                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger" onclick="return confirm('Delete this topic? This cannot be undone.')">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </div>
                <ul class="list-unstyled mb-2">
                  <% topic.subtopics.forEach((subtopic, subIndex) => { %>
                    <li class="d-flex align-items-start justify-content-between gap-2 text-muted small mb-1">
                      <span class="d-flex align-items-start gap-2">
                        <i class="fa-solid fa-minus mt-1 text-info"></i>
                        <span><%= subtopic %></span>
                      </span>
                      <form method="POST" action="/log/<%= each._id %>/topic/<%= topicIndex %>/subtopic/<%= subIndex %>?_method=DELETE" class="d-inline">
                        <button type="submit" class="btn btn-link btn-sm p-0 text-danger" onclick="return confirm('Delete this subtopic?')">
                          <i class="fa-solid fa-xmark"></i>
                        </button>
                      </form>
                    </li>
                  <% }) %>
                </ul>
                <p class="small text-white mb-0">
                  <span class="fw-semibold">Time:</span> <%= topic.time.hour %> h <%= topic.time.minute %> min
                </p>
              </div>
            <% }) %>

            <div class="d-flex flex-wrap gap-2 mt-4">
              <form method="get" action="/log/<%= each._id%>/edit" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-warning">
                  <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                </button>
              </form>
              <form method="POST" action="/log/<%= each._id%>?_method=DELETE" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this entire log? This action cannot be undone.')">
                  <i class="fa-solid fa-trash me-1"></i>Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 text-center text-muted">
          <i class="fa-solid fa-clipboard-list fa-2x text-info mb-3"></i>
          <p class="mb-0">No log entries yet. Add one to get started.</p>
        </div>
      </div>
    <% } %>
  </div>
</div>
